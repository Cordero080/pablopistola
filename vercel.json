{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/home", "destination": "/home.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/resume", "destination": "/resume.html" },
    { "source": "/skills", "destination": "/skills.html" },
    { "source": "/art", "destination": "/art.html" },
    { "source": "/lab", "destination": "/lab.html" },
    {
      "source": "/models/xenotchi/:path*",
      "destination": "https://transcendence-3-d-v2.vercel.app/models/:path*"
    }
  ]
}
