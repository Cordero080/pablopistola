{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "missing": [{ "type": "query", "key": "stay" }],
      "destination": "/home",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/models/xenotchi/:path*",
      "destination": "https://transcendence-3-d-v2.vercel.app/models/:path*"
    }
  ]
}
